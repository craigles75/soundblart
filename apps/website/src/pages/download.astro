---
import Base from '../layouts/Base.astro';
---

<Base title="Download Soundblart" description="Download Soundblart for macOS or Windows. Free, no account required.">
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-8 text-center">
    <h1 class="font-display text-display-lg text-on-surface">Download</h1>
    <p class="font-body text-body-lg text-on-surface-variant mt-4 max-w-lg mx-auto">
      Choose your platform. Free, offline, no account required.
    </p>
  </section>

  <!-- ─── Platform Cards ─────────────────────────────────────── -->
  <section class="w-full max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- macOS -->
      <div class="flex flex-col items-center p-8 rounded-card bg-surface-high shadow-pad-rest hover:bg-surface-highest transition-colors duration-150 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="text-on-surface mb-4" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
        </svg>
        <h2 class="font-display text-title-lg text-on-surface mb-2">macOS</h2>
        <p class="font-body text-body-md text-on-surface-variant mb-1">
          Universal binary (Apple Silicon + Intel)
        </p>
        <p class="font-body text-label-sm text-on-surface-variant mb-6">
          Requires macOS 13 (Ventura) or later
        </p>
        <a
          href="https://github.com/craigles75/soundblart/releases/latest"
          class="w-full font-body text-label-lg px-6 py-3 rounded-chip bg-primary text-primary-on hover:brightness-110 transition-all duration-150 active:scale-[0.97] text-center"
          target="_blank"
          rel="noopener noreferrer"
        >
          Download .dmg
        </a>
      </div>

      <!-- Windows -->
      <div class="flex flex-col items-center p-8 rounded-card bg-surface-high shadow-pad-rest hover:bg-surface-highest transition-colors duration-150 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="text-on-surface mb-4" aria-hidden="true">
          <path d="M3 12V6.75l8-1.25v6.5H3zm0 .5h8v6.5l-8-1.25V12.5zm9 0h9V4l-9 1.25V12.5zm0 .5v6.25L21 20v-7H12z" />
        </svg>
        <h2 class="font-display text-title-lg text-on-surface mb-2">Windows</h2>
        <p class="font-body text-body-md text-on-surface-variant mb-1">
          NSIS installer (x86_64)
        </p>
        <p class="font-body text-label-sm text-on-surface-variant mb-6">
          Requires Windows 10 or later
        </p>
        <a
          href="https://github.com/craigles75/soundblart/releases/latest"
          class="w-full font-body text-label-lg px-6 py-3 rounded-chip bg-primary text-primary-on hover:brightness-110 transition-all duration-150 active:scale-[0.97] text-center"
          target="_blank"
          rel="noopener noreferrer"
        >
          Download .exe
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Web App Coming Soon ─────────────────────────────────── -->
  <section class="w-full max-w-3xl mx-auto px-4 sm:px-6 py-12 text-center">
    <div class="p-8 rounded-card bg-surface-container">
      <div class="w-10 h-10 rounded-full bg-tertiary/15 flex items-center justify-center mx-auto mb-4">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-tertiary" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
        </svg>
      </div>
      <h3 class="font-display text-title-lg text-on-surface mb-2">Web App — Coming Soon</h3>
      <p class="font-body text-body-md text-on-surface-variant max-w-md mx-auto">
        A browser-based version of Soundblart is planned for a future release.
        For now, download the desktop app for the best experience.
      </p>
    </div>
  </section>
</Base>
